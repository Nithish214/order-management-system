{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeAnyInstance",
      "Effect": "Allow",
      "Action": "rds:DescribeDBInstances",
      "Resource": "*"
    },
    {
      "Sid": "DescribeAnyEc2Instance",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    },
    {
      "Sid": "StopThisOneInstanceOnly",
      "Effect": "Allow",
      "Action": "rds:StopDBInstance",
      "Resource": "arn:aws:rds:eu-west-1:244689414185:db:order-management-db"
    },
    {
      "Sid": "ReadWriteIdleTrackerState",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::order-management-cf-logs-244689414185/idle-tracker/*"
    },
    {
      "Sid": "ListBucketForIdleTrackerState",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::order-management-cf-logs-244689414185",
      "Condition": {
        "StringLike": { "s3:prefix": "idle-tracker/*" }
      }
    },
    {
      "Sid": "OwnLambdaLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:eu-west-1:244689414185:log-group:/aws/lambda/rds-idle-auto-stop:*"
    }
  ]
}
