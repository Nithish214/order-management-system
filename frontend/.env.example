# Copy to .env and fill in your own values. None of these are secrets -- the Cognito
# app client has no client secret (--no-generate-secret), and the Gateway URL is
# necessarily public anyway (it's what the browser calls). Vite only exposes vars
# prefixed VITE_ to client code -- anything else in .env stays server-side-only (moot
# here since this is a pure static frontend, but it's why the prefix matters generally).

VITE_GATEWAY_URL=https://<your-subdomain>.duckdns.org
VITE_COGNITO_REGION=eu-west-1
VITE_COGNITO_CLIENT_ID=<your-app-client-id>
